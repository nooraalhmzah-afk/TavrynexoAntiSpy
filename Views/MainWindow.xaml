<Window x:Class="TavrynexoAntiSpy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TavrynexoAntiSpy.ViewModels"
        Title="Tavrynexo AntiSpy - Professional Windows Privacy &amp; Security Suite" 
        Height="840" Width="1280"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextHeader}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="ModernSwitchToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchTrack" Width="48" Height="26" CornerRadius="13" Background="#CBD5E1" BorderBrush="#94A3B8" BorderThickness="1">
                            <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2563EB" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#1D4ED8" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryScanButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,18" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="🛡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tavrynexo" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="AntiSpy Suite" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,16">
                    <StackPanel>
                        <TextBlock Text="PROTECTION MODULES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="10,0,0,10" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Overview" Content="🛡 Overview &amp; Privacy Rules" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Telemetry" Content="📡 Telemetry &amp; Diagnostics" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Services" Content="⚙ Windows Services" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Advertising" Content="🎯 Advertising &amp; Timeline" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Cortana" Content="🔍 Cortana &amp; Search" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Location" Content="📍 Location &amp; Sensors" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="WindowsUpdate" Content="🚀 Update &amp; P2P Bandwidth" />

                        <TextBlock Text="SYSTEM SECURITY &amp; LOGS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="10,18,0,10" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="Security" Content="🔒 Windows Security Audit" />
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding SelectNavCommand}" CommandParameter="AuditLogs" Content="📋 SQLite Activity Logs" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F8FAFC" Padding="16" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="System Privacy Score" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PrivacyScore, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding PrivacyScore}" Maximum="100" Height="7" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" />
                        <TextBlock Text="ADMIN ELEVATED • SQLite LOCAL DB" FontSize="10" Foreground="#059669" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Toolbar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Prominent Primary Scan CTA -->
                        <Button Content="🔍 Start System Scan" Style="{StaticResource PrimaryScanButton}" Command="{Binding ScanCommand}" Margin="0,0,12,0" />
                        <!-- Review Proposed Changes Before Apply -->
                        <Button Content="🛡 Review &amp; Apply Baseline" Style="{StaticResource SecondaryButton}" Command="{Binding OpenReviewProposedCommand}" Margin="0,0,10,0" />
                        <Button Content="↩ Restore Defaults" Style="{StaticResource SecondaryButton}" Command="{Binding RevertAllCommand}" Margin="0,0,10,0" />
                        <Button Content="⚡ System Restore Point" Style="{StaticResource SecondaryButton}" Command="{Binding CreateRestorePointCommand}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Width="260" Padding="10,6">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" Foreground="#0F172A" BorderThickness="0" CaretBrush="#2563EB"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Independent Cards List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <ItemsControl ItemsSource="{Binding FilteredRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Recommendation}" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                                            </Border>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#2563EB" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,8,0,8" />
                                        <TextBlock Text="{Binding KeyPath, StringFormat='Target: {0}'}" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding LastVerificationMessage, StringFormat='Status: {0}'}" FontSize="11" Foreground="#059669" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <CheckBox IsChecked="{Binding IsApplied, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernSwitchToggle}"
                                                  Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="16,10">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#334155" />
            </Border>
        </Grid>
    </Grid>
</Window>
